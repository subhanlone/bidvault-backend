# Template for .env.test, which tests/setup.ts loads explicitly.
#
# Copy to .env.test and fill in the local Postgres password. .env.test is gitignored;
# this file is not, so never put a real credential here.
#
# Why a separate file at all: the backend has no dotenv dependency. In normal operation
# `.env` reaches process.env only as a side effect of importing @prisma/client, which
# loads it. Tests must not inherit that — pointing a test run at the development database
# would truncate it, and pointing it at the shared Redis is worse (see below). So the test
# environment is loaded deliberately, and tests/setup.ts refuses to run if it looks wrong.

NODE_ENV=test

# A database used by nothing else. Tests truncate every table between files, so this must
# NOT be the development database. tests/setup.ts requires the name to end in _test.
#   createdb bidvault_test    (or: psql -c 'CREATE DATABASE bidvault_test')
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/bidvault_test?schema=public"

# Must be a local Redis. Development and production have historically shared one remote
# instance, and a process pointed at the wrong one has already consumed a production job
# and silently destroyed it. tests/setup.ts refuses any host that is not loopback.
# Any free local port works. 6379 is often taken by another project, so the suite
# defaults to 6380:
#   docker run -d --name bidvault-test-redis -p 6380:6379 redis:8-alpine
REDIS_URL=redis://127.0.0.1:6380

# Namespaces the BullMQ keyspace. 'bull' is production's own prefix; setup.ts rejects it.
QUEUE_PREFIX=bull:test

# Placeholders. Nothing in the suite reaches these services: Stripe is mocked, Cloudinary
# signing is local HMAC, and the email service no-ops when RESEND_API_KEY is unset.
STRIPE_SECRET_KEY=sk_test_placeholder_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder_not_a_real_key
CLOUDINARY_CLOUD_NAME=test-placeholder
CLOUDINARY_API_KEY=test-placeholder
CLOUDINARY_API_SECRET=test-placeholder

# config/env.ts requires at least 16 characters.
JWT_ACCESS_SECRET=test-placeholder-not-a-real-secret
JWT_REFRESH_SECRET=test-placeholder-not-a-real-secret

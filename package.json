{
  "name": "bidvault-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/auction-lifecycle.worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "worker": "node dist/workers/auction-lifecycle.worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsx scripts/test-db.ts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "api:contract": "tsx scripts/generate-openapi.ts",
    "api:types": "tsx scripts/generate-client-types.ts",
    "api:routes": "tsx scripts/verify-routes.ts",
    "api:verify": "tsx scripts/verify-contract.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.53.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "resend": "^6.12.4",
    "socket.io": "^4.8.1",
    "stripe": "^22.1.1",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.31",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}

NODE_ENV=development
PORT=4000

# How many reverse proxies sit in front of this process, for Express's `trust proxy`.
# 0 locally (no proxy). On Railway it is at least 1, but the exact number depends on the
# deployed topology and must be measured against a running deployment -- see BV-022.
# Too low: req.ip is the proxy, not the client. Too high: a client can spoof its own address.
#
# REQUIRED when NODE_ENV=production -- the app refuses to boot without it, deliberately.
# Leaving it to the 0 default behind a proxy makes req.ip the edge address for every caller,
# so the IP rate limiters share one counter across the whole user base and the global
# 300/minute becomes the entire platform's ceiling. From outside that is indistinguishable
# from an outage, and nothing in the logs names the cause.
TRUST_PROXY_HOPS=0
# Comma-separated list of allowed frontend origins (no spaces, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL — local dev uses localhost; Railway uses its managed DB URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bidvault?schema=public"
DATABASE_CONNECTION_LIMIT=10

# Redis — can point to a cloud Redis (redis.io) or local redis://localhost:6379
REDIS_URL=redis://localhost:6379

# BullMQ keyspace namespace. Leave as bull:dev locally. If your REDIS_URL points at
# the same Redis instance production uses, this is what stops a locally-run worker
# from consuming production jobs — it would find no matching auction in your local
# database, return early, and mark the job completed, so that auction would never
# close. Production leaves this unset and takes BullMQ's default of "bull".
QUEUE_PREFIX=bull:dev

# Resend — transactional email
# Get your API key at https://resend.com/api-keys
# Leave blank to disable emails locally (a warning will be logged instead)
RESEND_API_KEY=re_...
# From address — use onboarding@resend.dev for testing (delivers to your Resend account email only)
# For production, verify your domain at https://resend.com/domains and use: BidVault <noreply@yourdomain.com>
RESEND_FROM_EMAIL=BidVault <onboarding@resend.dev>

# JWT — generate two separate long random strings (min 32 chars each)
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-long-random-string-min-16-chars
JWT_REFRESH_EXPIRES_IN_DAYS=14

# Stripe — use test mode keys from dashboard.stripe.com or copy from Railway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary — from cloudinary.com dashboard or copy from Railway
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed passwords — required by `npm run prisma:seed`, no defaults.
# scripts/seed-guard.ts refuses to run without them, so that no working
# credential ever lives in source. Choose your own; min 8 characters.
SEED_BUYER_PASSWORD=
SEED_SELLER_PASSWORD=
SEED_ADMIN_PASSWORD=
# Required only by scripts/seed-demo-auctions.ts
SEED_DEMO_PASSWORD=

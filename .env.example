NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (no spaces, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL — local dev uses localhost; Railway uses its managed DB URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bidvault?schema=public"

# Redis — can point to a cloud Redis (redis.io) or local redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Resend — transactional email
# Get your API key at https://resend.com/api-keys
# Leave blank to disable emails locally (a warning will be logged instead)
RESEND_API_KEY=re_...
# From address — use onboarding@resend.dev for testing (delivers to your Resend account email only)
# For production, verify your domain at https://resend.com/domains and use: BidVault <noreply@yourdomain.com>
RESEND_FROM_EMAIL=BidVault <onboarding@resend.dev>

# JWT — generate two separate long random strings (min 32 chars each)
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-long-random-string-min-16-chars
JWT_REFRESH_EXPIRES_IN_DAYS=14

# Stripe — use test mode keys from dashboard.stripe.com or copy from Railway
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary — from cloudinary.com dashboard or copy from Railway
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

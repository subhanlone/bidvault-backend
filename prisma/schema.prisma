generator client {
  provider        = "prisma-client-js"
  // BV-017: needed to declare the trigram GIN indexes below in the schema itself, so `db push`/
  // `migrate diff` stay aware of them instead of treating hand-written SQL as drift.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ItemCondition {
  NEW
  LIKE_NEW
  USED
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  // BV-004 / BV-006: an admin's only way to give up on a transaction that will never be paid
  // (an uncapped-bid winner who vanishes, a buyer who never returns after a decline). Reachable
  // only from PENDING -- a COMPLETED sale needs a refund, not a void.
  VOIDED
  // BV-047: the post-payment fulfilment states A4 never had. Money is captured at COMPLETED,
  // same as before -- everything below describes what happens to the *item*, not the charge.
  //   COMPLETED -> SHIPPED   seller marks it sent; starts the reviewTimeoutHours clock (BV-040)
  //   SHIPPED   -> DELIVERED buyer confirms receipt, or the clock runs out -- fires the seller payout
  //   SHIPPED   -> DISPUTED  buyer reports not-received / not-as-described within the window
  //   DISPUTED  -> DELIVERED admin sides with the seller -- releases the payout that was on hold
  //   DISPUTED  -> REFUNDED  admin sides with the buyer -- refunds the charge, no payout ever fires
  // Revenue aggregates now select every status below rather than just COMPLETED (the sale still
  // happened), explicitly excluding REFUNDED (the money went back) -- see auction-dto.ts and
  // admin.routes.ts.
  SHIPPED
  DELIVERED
  DISPUTED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUNDED
  RESOLVED_RELEASED
}

// BV-018: no route deletes a User today. When one is added it can only be anonymise-in-place
// (clear name/email, revoke refresh tokens) rather than a real DELETE -- Listing/Auction already
// RESTRICT a seller's removal, AuctionTransaction RESTRICTs winner/seller too. Bid.buyerId
// SetNull already handles a buyer's own bids safely; this comment is the placeholder the audit
// asked for until the rest of that route exists.
model User {
  id                 String                   @id @default(cuid())
  name               String
  email              String                   @unique
  passwordHash       String
  role               UserRole
  isEmailVerified    Boolean                  @default(false)
  notifyOutbid       Boolean                  @default(true)
  notifyWins         Boolean                  @default(true)
  notifyNews         Boolean                  @default(false)
  // A seller's accumulated payout balance from the dummy gateway — no external account, no
  // onboarding step. Credited by fulfillment.service.ts's creditSeller() when a sale reaches
  // DELIVERED; each credit's own record lives in LedgerEntry below, this is the running total.
  ledgerBalance      Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  listings           Listing[]                @relation("SellerListings")
  bids               Bid[]                    @relation("BuyerBids")
  watchlistEntries   Watchlist[]
  auctionsAsSeller   Auction[]                @relation("SellerAuctions")
  emailTokens        EmailVerificationToken[]
  passwordResetCodes PasswordResetToken[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  winningTxns        AuctionTransaction[]     @relation("WinnerTransactions")
  sellingTxns        AuctionTransaction[]     @relation("SellerTransactions")
  auditLogs          AuditLog[]               @relation("ActorAuditLogs")
  reviewsGiven       SellerReview[]           @relation("BuyerReviews")
  reviewsReceived    SellerReview[]           @relation("SellerReviews")
  ledgerEntries      LedgerEntry[]
}

model Listing {
  id              String        @id @default(cuid())
  listingCode     String        @unique
  sellerId        String
  title           String
  category        String
  condition       ItemCondition
  description     String
  startPrice      Int
  reservePrice    Int?
  minIncrement    Int
  durationDays    Int
  status          ListingStatus @default(PENDING)
  rejectionReason String?
  imageUrl        String?
  emoji           String?
  attributes      Json?
  submittedAt     DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seller          User          @relation("SellerListings", fields: [sellerId], references: [id])
  auction         Auction?

  @@index([status, submittedAt])
  @@index([sellerId, submittedAt])
}

model Auction {
  id           String               @id @default(cuid())
  listingId    String               @unique
  sellerId     String
  title        String
  category     String
  condition    ItemCondition
  description  String
  imageUrl     String?
  emoji        String?
  startPrice   Int
  reservePrice Int?
  // Outcome of the reserve check, written once when the auction closes.
  // null  = no reserve was set, or the auction has not closed yet
  // true  = closed at or above reserve; an AuctionTransaction exists
  // false = closed below reserve; deliberately NO transaction, nothing owed
  reserveMet   Boolean?
  minIncrement Int
  currentBid   Int
  bidCount     Int                  @default(0)
  attributes   Json?
  status       AuctionStatus        @default(ACTIVE)
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  listing      Listing              @relation(fields: [listingId], references: [id])
  seller       User                 @relation("SellerAuctions", fields: [sellerId], references: [id])
  bids         Bid[]
  watchlistBy  Watchlist[]
  transactions AuctionTransaction[]
  reviews      SellerReview[]

  @@index([status, endTime])
  @@index([sellerId])
  // BV-017: the search box's `contains ... mode: 'insensitive'` on title/description
  // (auctions.routes.ts) is an unanchored ILIKE '%…%', which no B-tree index can serve --
  // confirmed with EXPLAIN even with sequential scans forcibly disabled, the planner still had
  // no alternative. These are the only indexes in the schema that answer it.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  // BV-018: nullable, SetNull instead of Cascade. Deleting a buyer used to delete their bids
  // outright, leaving Auction.bidCount/currentBid pointing at rows that no longer existed --
  // closeAuction would then silently re-award to a lower bidder with no record of why. Keeping
  // the row and anonymising the owner instead means those columns stay accurate regardless of
  // what happens to the account; close-auction.ts excludes a null-buyer bid when picking a
  // winner, since there is no one left to write into AuctionTransaction.winnerId.
  buyerId   String?
  amount    Int
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  buyer     User?    @relation("BuyerBids", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([auctionId, createdAt])
  @@index([buyerId, createdAt])
}

model Watchlist {
  userId    String
  auctionId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([auctionId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  userAgent         String?
  ipAddress         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AuctionTransaction {
  id               String            @id @default(cuid())
  auctionId        String
  winnerId         String
  sellerId         String
  finalAmount      Int
  status           TransactionStatus @default(PENDING)
  // Set by the dummy payment gateway (services/payment-gateway.service.ts) on a successful
  // charge. Format PAY-<random>, generated by this app -- nothing external to reconcile
  // against.
  paymentReference String?           @unique
  // Why the last payment attempt failed, in the buyer's language.
  //
  // The failure used to live in `status` alone: payment_intent.payment_failed wrote FAILED,
  // and create-intent refused anything that was not PENDING — so one declined card ended the
  // sale permanently, with no route back and nothing explaining why. A declined card is an
  // ordinary event, not a terminal state, so the reason belongs in its own column and the
  // status returns to PENDING for a retry.
  //
  // Cleared whenever a fresh intent is created, so it always describes the most recent
  // attempt rather than accumulating history.
  lastPaymentError String?
  // BV-047 / E4: collected from the buyer alongside create-intent -- a per-sale snapshot rather
  // than a User-profile field, since different sales can reasonably ship to different places.
  // Both null until payment; deliveryAddress is required before the seller can mark SHIPPED.
  deliveryAddress  String?
  deliveryPhone    String?
  // Set when the seller marks the item SHIPPED. The reviewTimeoutHours confirm-or-dispute
  // window (BV-040) is measured from here, not from COMPLETED -- the buyer's clock should not
  // run while the seller hasn't sent anything yet.
  shippedAt        DateTime?
  createdAt        DateTime          @default(now())
  auction          Auction           @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade (BV-018): a financial record must not disappear because the row it
  // references did. There is no account-deletion route yet, so nothing currently exercises
  // this, but the moment one exists it can only be anonymise-in-place — clear the PII fields,
  // keep the row — because this constraint refuses to let the User row itself be removed
  // while it still has transaction history.
  winner           User              @relation("WinnerTransactions", fields: [winnerId], references: [id], onDelete: Restrict)
  seller           User              @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  review           SellerReview?
  dispute          Dispute?
  ledgerEntry      LedgerEntry?

  @@unique([auctionId])
  @@index([sellerId, status])
  @@index([winnerId])
}

// The dummy gateway's payout record — one per DELIVERED transaction, written by
// creditSeller() alongside incrementing User.ledgerBalance. Kept as its own row (not just
// the running total) so a seller's Earnings view can show individual sales, not just a number.
model LedgerEntry {
  id            String             @id @default(cuid())
  sellerId      String
  transactionId String             @unique
  amount        Int
  createdAt     DateTime           @default(now())
  seller        User               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  transaction   AuctionTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
}

// BV-047 / E6: the platform previously had no way to express "item never arrived", "arrived
// broken" or "not as described" at all. One dispute per transaction -- reachable only from
// SHIPPED (see TransactionStatus) -- is enough for a buyer-initiated report reviewed by an
// admin; there is no need for a multi-message ticket thread on top of it yet.
model Dispute {
  id               String             @id @default(cuid())
  transactionId    String             @unique
  transaction      AuctionTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  raisedByUserId   String
  reason           String
  status           DisputeStatus      @default(OPEN)
  resolvedByUserId String?
  resolutionNote   String?
  createdAt        DateTime           @default(now())
  resolvedAt       DateTime?

  @@index([status])
}

model SellerReview {
  id            String             @id @default(cuid())
  transactionId String             @unique
  auctionId     String
  buyerId       String
  sellerId      String
  stars         Int
  comment       String?
  createdAt     DateTime           @default(now())
  transaction   AuctionTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  auction       Auction            @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  buyer         User               @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User               @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
}

model PlatformSetting {
  id                 String   @id @default("singleton")
  emailNotifsEnabled Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  maxBidIncrement    Int      @default(500000)
  minListingPrice    Int      @default(1000)
  reviewTimeoutHours Int      @default(48)
  supportEmail       String   @default("support@bidvault.tech")
  updatedAt          DateTime @updatedAt
}
